# ──────────────────────────────────────────────────────────────
# Panda Browser Gateway — Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Provider ──────────────────────────────────────────────────
# Options: chatgpt | claude | gemini | deepseek
PROVIDER=chatgpt

# Fallback chain (comma-separated). If primary fails, try next.
# Example: PROVIDER_CHAIN=chatgpt,claude,gemini
PROVIDER_CHAIN=

# ── Default Models ───────────────────────────────────────────
# These are selected in the provider UI when a request comes in.
CHATGPT_DEFAULT_MODEL=gpt-4o
CLAUDE_DEFAULT_MODEL=claude-3-5-sonnet-20241022
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
DEEPSEEK_DEFAULT_MODEL=deepseek-r1

# ── Multi-session Pool ───────────────────────────────────────
# Number of parallel browser instances. 1 = single browser (default).
# Set to 3 for 3x throughput (requires 3x RAM/CPU).
POOL_SIZE=1

# ── Browser ──────────────────────────────────────────────────
BROWSER_DATA_DIR=./browser_data
HEADLESS=false
SLOW_MO=50

# Browser mode: launch (default) | cdp | android
BROWSER_MODE=launch

# CDP: URL of existing Chrome DevTools Protocol endpoint
BROWSER_CDP_URL=

# Android WebView bridge port
WEBVIEW_BRIDGE_PORT=9221

# ── Provider URLs ────────────────────────────────────────────
CHATGPT_URL=https://chatgpt.com
CLAUDE_URL=https://claude.ai
GEMINI_URL=https://aistudio.google.com/app/prompts/new_chat
DEEPSEEK_URL=https://chat.deepseek.com

# ── Timeouts (milliseconds) ─────────────────────────────────
RESPONSE_TIMEOUT=120000
SELECTOR_TIMEOUT=10000

# ── Human Behavior Simulation ───────────────────────────────
TYPING_SPEED_MIN=50
TYPING_SPEED_MAX=150
THINKING_PAUSE_MIN=1000
THINKING_PAUSE_MAX=3000

# ── Logging ──────────────────────────────────────────────────
LOG_DIR=./logs
LOG_LEVEL=INFO
VERBOSE=true

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Minimum seconds between API requests (rate limiting).
RATE_LIMIT_SECONDS=5

# Bearer token for API authentication.
# Include in every request: Authorization: Bearer <token>
# Empty = no auth.
API_TOKEN=dummy123

# ── Response Cache ───────────────────────────────────────────
# Cache TTL in seconds. 0 = disabled.
CACHE_TTL=0

# ── Media Pipeline ───────────────────────────────────────────
# Backend for audio/image/video/PDF processing.
# Options: local (CPU models) | hosted (external API/VPS)
MEDIA_BACKEND=local

# Hosted backend options (used when MEDIA_BACKEND=hosted):
# Groq Whisper API key for audio transcription
WHISPER_API_KEY=
# Vision API key for image description
VISION_API_KEY=
# Self-hosted model endpoint (e.g. Gemma 4 on your VPS)
MEDIA_MODEL_URL=
MEDIA_MODEL_KEY=

# ── VNC (Docker only) ────────────────────────────────────────
VNC_PASSWORD=catgpt
