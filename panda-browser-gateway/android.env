# ── Panda Browser Gateway — Android optimized config ──────────────────────────
# Mode navigateur : android | cdp | launch
BROWSER_MODE=android

# Port du bridge Flutter WebView (HTTP local)
WEBVIEW_BRIDGE_PORT=9221

# Si mode=cdp, URL du DevTools Protocol Chrome déjà lancé
# BROWSER_CDP_URL=http://127.0.0.1:9222

# Pas de Chromium sur Android — désactiver
HEADLESS=true
SLOW_MO=0

# Provider par défaut
PROVIDER=chatgpt

# API
API_HOST=127.0.0.1
API_PORT=8000
# API_TOKEN=ton_token_ici

# Dashboard Next.js
# DASHBOARD_PORT=3000

# Logs
LOG_LEVEL=INFO
VERBOSE=false

# Timeouts allongés pour mobile
RESPONSE_TIMEOUT=180000
SELECTOR_TIMEOUT=15000
POLL_INTERVAL_MS=500
