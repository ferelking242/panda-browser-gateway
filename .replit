modules = ["nodejs-24", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Panda Dashboard"

[[workflows.workflow]]
name = "Panda Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/panda-browser-gateway && ( /home/runner/workspace/.pythonlibs/bin/python -m uvicorn src.api.server:app --host 0.0.0.0 --port 8000 --log-level info > /tmp/panda-api.log 2>&1 & ) && cd dashboard && PORT=5000 npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
